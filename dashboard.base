filters:
  or:
    - type == "source"
    - type == "concept"
    - type == "method"
    - type == "comparison"
    - type == "analysis"
views:
  - type: table
    name: Recently Ingested Sources
    filters:
      and:
        - type == "source"
    order:
      - file.name
      - created
      - updated
    summaries:
      file.name: Count
  - type: table
    name: LLM-Ready Sources
    filters:
      and:
        - type == "source"
        - llm_ready == true
    order:
      - file.name
      - ingest_level
      - coverage
      - updated
    summaries:
      file.name: Count
  - type: table
    name: Sources Needing Deepening
    filters:
      and:
        - type == "source"
        - llm_ready != true
    order:
      - coverage
      - ingest_level
      - file.name
      - updated
    summaries:
      file.name: Count
  - type: cards
    name: Concept Library
    filters:
      and:
        - type == "concept"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - tags
    summaries:
      file.name: Count
  - type: table
    name: UX Research Methods
    filters:
      and:
        - type == "method"
    order:
      - file.name
      - method_family
      - best_for
      - updated
    summaries:
      file.name: Count
  - type: table
    name: Comparison Matrices
    filters:
      and:
        - type == "comparison"
    order:
      - file.name
      - updated
      - confidence
    summaries:
      file.name: Count
  - type: table
    name: Analysis Memos
    filters:
      and:
        - type == "analysis"
    order:
      - updated
      - file.name
      - confidence
    summaries:
      file.name: Count
  - type: list
    name: Items Needing Review
    filters:
      and:
        - status == "needs-review"
    order:
      - file.name
      - updated
  - type: table
    name: Drafts / Needs Work
    filters:
      and:
        - status == "draft"
    order:
      - file.name
      - updated
      - confidence
    summaries:
      file.name: Count
  - type: table
    name: Low Confidence (< 0.7)
    filters:
      and:
        - confidence < 0.7
        - type != "log"
    order:
      - confidence
      - file.name
      - updated
    summaries:
      file.name: Count
  - type: table
    name: Lost Content Awaiting Re-ingest
    filters:
      and:
        - tags.contains("lost-content")
    order:
      - file.name
      - updated
    summaries:
      file.name: Count
  - type: table
    name: Stale (not touched in 60 days)
    filters:
      and:
        - type == "concept"
        - updated < (now() - "60 days")
    order:
      - updated
      - file.name
    summaries:
      file.name: Count
